## BertBot local runtime settings
# Copy this file to .env and provide your local values.
# For Docker Compose deployment, copy .env.compose.example to .env.compose instead.
# Owner: local Gradle runs (CLI, headless, MCP, webhook, Discord).
# Do NOT use this file for Docker Compose or Cloud Run.
# See docs/configuration.md#environment-file-usage for the full file-to-context mapping.
# Run scripts/check-env-drift.sh to verify active-key parity with .env.compose.example.

# AI provider settings.
# Supported adapters: openai, ollama
BERTBOT_AI_PROVIDER=openai
BERTBOT_AI_MODEL=gpt-4o-mini
BERTBOT_AI_API_KEY=your-api-key-here

# Ollama adapter settings (used when BERTBOT_AI_PROVIDER=ollama).
BERTBOT_OLLAMA_BASE_URL=http://localhost:11434
BERTBOT_OLLAMA_TIMEOUT_SECONDS=120

# MCP and workspace settings.
BERTBOT_WORKSPACE_ROOT=.

# Docker/container runtime mode (used by docker/entrypoint.sh).
# Ignored by local Gradle task selection; keep this for parity checks with .env.compose.
# Supported values: webhook, mcp, headless, interactive, discord
BERTBOT_RUN_MODE=webhook

# MacroFactor MCP proxy settings.
# Set BERTBOT_MACROFACTOR_ENABLED=true and fill credentials to enable locally.
BERTBOT_MACROFACTOR_ENABLED=false
BERTBOT_MACROFACTOR_COMMAND=npx
BERTBOT_MACROFACTOR_ARGS=-y,sjawhar-macrofactor
BERTBOT_MACROFACTOR_USERNAME=
BERTBOT_MACROFACTOR_PASSWORD=
BERTBOT_MACROFACTOR_TIMEOUT_SECONDS=45
BERTBOT_MACROFACTOR_TOOL_NAME_PREFIX=macrofactor_
# Optional live integration test settings (used by MacrofactorToolRouterLiveIntegrationTest).
BERTBOT_MACROFACTOR_LIVE_TEST=false
BERTBOT_MACROFACTOR_LIVE_TOOL=
BERTBOT_MACROFACTOR_LIVE_ARGS_JSON={}
BERTBOT_MACROFACTOR_EXPECTED_TOOL=
BERTBOT_MACROFACTOR_EXPECTED_ARG=

# Google Workspace MCP proxy settings.
# Set BERTBOT_GOOGLE_WORKSPACE_ENABLED=true to enable locally.
BERTBOT_GOOGLE_WORKSPACE_ENABLED=false
BERTBOT_GOOGLE_WORKSPACE_COMMAND=npx
BERTBOT_GOOGLE_WORKSPACE_ARGS=-y,-p,github:gemini-cli-extensions/workspace#v0.0.8,gemini-workspace-server
BERTBOT_GOOGLE_WORKSPACE_TIMEOUT_SECONDS=60
BERTBOT_GOOGLE_WORKSPACE_TOOL_NAME_PREFIX=google_workspace_

# Desktop automation MCP bridge settings.
# Set BERTBOT_DESKTOP_AUTOMATION_ENABLED=true to enable the desktop automation proxy.
BERTBOT_DESKTOP_AUTOMATION_ENABLED=false
BERTBOT_DESKTOP_AUTOMATION_COMMAND=npx
BERTBOT_DESKTOP_AUTOMATION_ARGS=
BERTBOT_DESKTOP_AUTOMATION_TIMEOUT_SECONDS=60
BERTBOT_DESKTOP_AUTOMATION_TOOL_NAME_PREFIX=desktop_automation_

# Shopping configuration.
# Set BERTBOT_SHOPPING_ENABLED=true and configure at least one store slot to enable.
# Enabling personal_shopper without at least one store slot enabled causes startup to fail.
BERTBOT_SHOPPING_ENABLED=false
BERTBOT_SHOPPING_BUDGET_LIMIT_CENTS=10000
BERTBOT_SHOPPING_MIN_SELLER_TRUST_SCORE=0.7
# Shopping store slots (supports up to 9 numbered slots; uncomment and fill to activate).
# BERTBOT_SHOPPING_STORE_1_ENABLED=false
# BERTBOT_SHOPPING_STORE_1_MODE=browse
# BERTBOT_SHOPPING_STORE_1_PRIORITY=100
# BERTBOT_SHOPPING_STORE_1_REGION=us
# BERTBOT_SHOPPING_STORE_1_CURRENCY=usd

# Playwright browser store adapter (optional fallback for stores without a stable API).
# Disabled by default. Three modes per store: api (default), browser, hybrid.
BERTBOT_PLAYWRIGHT_STORE_ENABLED=false
BERTBOT_PLAYWRIGHT_STORE_DEFAULT_MODE=api
# Per-store mode overrides as store1:hybrid,store2:browser. Leave blank for all-default.
BERTBOT_PLAYWRIGHT_STORE_MODES=
# Comma-separated allowlist. Leave blank to use built-in defaults (navigate,click,fill,read,screenshot,select,hover,scroll).
BERTBOT_PLAYWRIGHT_STORE_ALLOWED_BROWSER_ACTIONS=

# State persistence backend settings.
# Supported values: file, jdbc, postgres, postgresql
BERTBOT_STATE_STORE=file
# JSON codec for state serialization. Supported values: gson (default), kotlinx.
BERTBOT_JSON_CODEC=gson
BERTBOT_STATE_FILE_PATH=state/bertbot-state.json
BERTBOT_MEMORY_EPISODIC_FILE_PATH=state/bertbot-memory.txt
BERTBOT_MEMORY_SEMANTIC_FILE_PATH=state/bertbot-semantic-memory.txt
BERTBOT_PROFILE_FILE_PATH=state/bertbot-profile.json
BERTBOT_INGESTION_CONSENT_FILE_PATH=state/bertbot-ingestion-consent.json
BERTBOT_INGESTION_SOURCE_STATE_FILE_PATH=state/bertbot-ingestion-source-state.json
BERTBOT_RESEARCH_RECOMMENDATIONS_FILE_PATH=state/bertbot-research-recommendations.json
BERTBOT_SESSION_HISTORY_FILE_PATH=state/bertbot-session-history.jsonl
BERTBOT_TRACE_FILE_PATH=logs/bertbot-trace.jsonl
BERTBOT_INTERACTIONS_FILE_PATH=state/bertbot-interactions.mmd

# Checkpoint and event-sourcing settings.
BERTBOT_CHECKPOINT_AUTOSAVE_ENABLED=false
BERTBOT_CHECKPOINT_FILE_PATH=state/bertbot-checkpoints.json
BERTBOT_EVENT_SOURCING_ENABLED=false
BERTBOT_STATE_EVENT_FILE_PATH=state/bertbot-state-events.json

# JDBC or PostgreSQL connection settings (leave blank when BERTBOT_STATE_STORE=file).
BERTBOT_STATE_JDBC_URL=
BERTBOT_STATE_JDBC_USER=
BERTBOT_STATE_JDBC_PASSWORD=
BERTBOT_STATE_JDBC_TABLE=bertbot_state_snapshot
BERTBOT_CHECKPOINT_JDBC_TABLE=bertbot_checkpoint_snapshot
BERTBOT_STATE_EVENT_JDBC_TABLE=bertbot_state_event
BERTBOT_MEMORY_EPISODIC_JDBC_TABLE=bertbot_memory_episodic_snapshot
BERTBOT_MEMORY_SEMANTIC_JDBC_TABLE=bertbot_memory_semantic_snapshot
BERTBOT_PROFILE_JDBC_TABLE=bertbot_profile_snapshot
BERTBOT_INGESTION_CONSENT_JDBC_TABLE=bertbot_ingestion_consent_snapshot
BERTBOT_INGESTION_SOURCE_STATE_JDBC_TABLE=bertbot_ingestion_source_state_snapshot
BERTBOT_SESSION_HISTORY_JDBC_TABLE=bertbot_session_history_event

# Session history and learning review controls.
BERTBOT_SESSION_HISTORY_ENABLED=true
BERTBOT_SESSION_HISTORY_MAX_ENTRIES_PER_SCOPE=2000
BERTBOT_LEARNING_REVIEW_ENABLED=true
BERTBOT_LEARNING_REVIEW_FILE_PATH=state/bertbot-learning-review.jsonl
BERTBOT_LEARNING_REVIEW_JDBC_TABLE=bertbot_learning_review_queue
BERTBOT_LEARNING_REVIEW_DECISION_JDBC_TABLE=bertbot_learning_review_decision_event
BERTBOT_MEMORY_WRITE_APPROVAL_REQUIRED=false
BERTBOT_SKILL_WRITE_APPROVAL_REQUIRED=false

# Runtime environment tag (dev, staging, production).
# Controls checkpoint rollback protection: rollback into prod/staging requires BERTBOT_CHECKPOINT_ROLLBACK_ALLOW_PROTECTED=true.
BERTBOT_RUNTIME_ENV=dev
BERTBOT_CHECKPOINT_ROLLBACK_ENABLED=true
BERTBOT_CHECKPOINT_ROLLBACK_REQUIRE_CONFIRM=true
BERTBOT_CHECKPOINT_ROLLBACK_ALLOW_PROTECTED=false

# Koog integration settings.
BERTBOT_KOOG_CHAT_MEMORY_ENABLED=true
BERTBOT_KOOG_CHAT_MEMORY_WINDOW_SIZE=50
BERTBOT_KOOG_LONG_TERM_MEMORY_ENABLED=true
BERTBOT_KOOG_LONG_TERM_MEMORY_TOP_K=5
# OpenTelemetry tracing (optional; leave BERTBOT_KOOG_OTEL_OTLP_ENDPOINT blank to disable).
BERTBOT_KOOG_OTEL_SERVICE_NAME=personalagent-bertbot
BERTBOT_KOOG_OTEL_SERVICE_VERSION=0.1.0
BERTBOT_KOOG_OTEL_VERBOSE=false
BERTBOT_KOOG_OTEL_OTLP_ENDPOINT=

# Continuous improvement research overrides.
BERTBOT_RESEARCH_ENABLED=true
BERTBOT_RESEARCH_EVENT_DRIVEN_ENABLED=true
BERTBOT_RESEARCH_PERIODIC_ENABLED=true
BERTBOT_RESEARCH_LLM_ASSISTED_ENABLED=true
BERTBOT_RESEARCH_INCLUDE_EXTERNAL_SIGNALS=true
BERTBOT_RESEARCH_PERIODIC_INTERVAL_SECONDS=21600
BERTBOT_RESEARCH_MIN_INTERVAL_SECONDS=300
BERTBOT_RESEARCH_MAX_RECOMMENDATIONS_PER_CYCLE=8
BERTBOT_RESEARCH_FAILURE_COOLDOWN_SECONDS=900

# Polymarket endpoint overrides.
BERTBOT_POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
BERTBOT_POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
BERTBOT_POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com

# Webhook server bind settings.
BERTBOT_WEBHOOK_HOST=0.0.0.0
BERTBOT_WEBHOOK_PORT=8088
BERTBOT_WEBHOOK_TELEGRAM_PATH=/webhook/telegram
BERTBOT_WEBHOOK_SLACK_PATH=/webhook/slack
BERTBOT_WEBHOOK_WHATSAPP_PATH=/webhook/whatsapp
BERTBOT_WEBHOOK_HEALTH_PATH=/health

# When true, process webhook payloads without persistence writes.
BERTBOT_WEBHOOK_DRY_RUN=false

# Enable provider signature checks for webhook requests.
BERTBOT_WEBHOOK_REQUIRE_SIGNATURES=false

# Trust forwarded IP headers from a known reverse proxy.
BERTBOT_WEBHOOK_TRUST_PROXY_HEADERS=false

# Optional allowlist (comma-separated IPs/CIDRs). Leave blank to allow all.
BERTBOT_WEBHOOK_ALLOWED_IPS=

# Per-client rate limit settings.
BERTBOT_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
BERTBOT_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=120

# Connector toggles.
BERTBOT_TELEGRAM_ENABLED=true
BERTBOT_SLACK_ENABLED=false
BERTBOT_WHATSAPP_ENABLED=false
BERTBOT_DISCORD_ENABLED=false
# Optional custom Telegram Bot API server (leave blank to use api.telegram.org).
BERTBOT_TELEGRAM_API_BASE_URL=

# Outbound API credentials for async status/final follow-up delivery.
BERTBOT_TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
BERTBOT_SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN
BERTBOT_WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_ACCESS_TOKEN
BERTBOT_WHATSAPP_API_VERSION=v22.0

# Discord bot runtime settings.
BERTBOT_DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
BERTBOT_DISCORD_GUILD_ID=
BERTBOT_DISCORD_APPROVED_CHANNEL_IDS=
BERTBOT_DISCORD_APPROVED_DIRECT_MESSAGE_IDS=

# Optional connector platform metadata.
BERTBOT_SLACK_WORKSPACE_ID=
BERTBOT_WHATSAPP_BUSINESS_PHONE_ID=

# Require explicit source approval before accepting ingested messages.
BERTBOT_INGESTION_REQUIRE_APPROVAL=false

# Provider verification tokens (used when BERTBOT_WEBHOOK_REQUIRE_SIGNATURES=true).
BERTBOT_TELEGRAM_SECRET_TOKEN=REPLACE_WITH_TELEGRAM_WEBHOOK_SECRET_TOKEN
BERTBOT_SLACK_SIGNING_SECRET=REPLACE_WITH_SLACK_SIGNING_SECRET
BERTBOT_SLACK_MAX_REQUEST_AGE_SECONDS=300
BERTBOT_WHATSAPP_APP_SECRET=REPLACE_WITH_WHATSAPP_APP_SECRET
BERTBOT_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_WHATSAPP_VERIFY_TOKEN

