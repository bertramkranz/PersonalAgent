        GraphFactory[BertBotGraphFactory]
        ConnectorFactory[BertBotConnectorRuntimeFactory]
        ResearchFactory[BertBotRuntimeDependenciesFactory]
        PayloadDispatcher[ExternalChatPayloadDispatcher\\noutbound payload and text normalization]
        KoogIntegration[KoogRuntimeIntegration]
        FollowupSender[ExternalChatFollowupSender\\noutbound platform replies:\nTelegram / Slack / WhatsApp / Discord]
    end

    subgraph GraphExecution
        Runner[BertBotGraphRunner]
        Capture[Capture Node]
        ResearchPlanner[Research Planner Node]
        Planner[Planner Node]
        EvidenceJudge[Evidence Judge Node]
        SafetyGuardian[Safety Guardian Node]
        ModelRouter[Model Router Node]
        Delegate[Delegation Node]
        Execute[Executor Node]
        IncidentDetector[Incident Detector Node]
        IncidentCommander[Incident Commander Node]
        State[(State Snapshot)]
        StateFile[(state/bertbot-state.json)]
        JdbcState[(JDBC State Store)]
        TraceFile[(logs/bertbot-trace.jsonl)]
        DiagramFile[(state/bertbot-interactions.mmd)]
        CheckpointStore[(Checkpoints: File or JDBC)]
        StateEventStore[(State Events: File or JDBC)]
    end

    subgraph RollbackAndReplay
        CompensatingRollback[CompensatingRollbackService]
        StateOnlyRollback[StateOnlyRollbackService]
        StateReplay[StateReplayService]
    end

    subgraph PlanningAndLLM
        Config[BertBotAgentConfig]
        ExecutionProfiles[SubAgentExecutionProfileDefinition]
        RuntimeFlags[Runtime Capability Snapshot\\nBertBotSupport]
        PromptBuilder[buildSystemPrompt]
        CapabilityResponder[buildCapabilityStatusResponse\\nkeyword-based capability detection]
        Registry[SubAgentRegistry]
        Skill[SelfCorrectingSkill]
        StructuredOutput[StructuredOutputGateway]
        LLM[LlmGateway / OpenAiLlmGateway / OllamaLlmGateway]
    end

    subgraph Memory
        Episodic[(Episodic Memory: File or JDBC)]
        Semantic[(state/bertbot-semantic-memory.txt)]
        Profile[(User Profile: File or JDBC)]
        Summarizer[MemorySummarizationWorker]
    end

    subgraph ExternalIngestion
        Control[IngestionControlPlane]
        Consent[(Consent Store: File or JDBC)]
        SourceState[(Source State Store: File or JDBC)]
        Telegram[Telegram Adapter]
        Slack[Slack Adapter]
        WhatsApp[WhatsApp Adapter]
        DiscordBridge[DiscordChatBridge]
    end

    subgraph McpHandlers
        CheckpointHandler[McpCheckpointToolHandler]
        IngestionHandler[McpIngestionToolHandler]
        SessionHistoryRouter[SessionHistoryToolRouter\nsession_history_list/search/clear]
        LearningReviewRouter[LearningReviewToolRouter\nlearning_review_list/approve/reject]
        StatusProvider[McpStatusProviderFactory]
    end

    subgraph LearningReviewAndSession
        SessionHistoryStore[(Session History Store: File or JDBC)]
        LearningReviewStore[(Learning Review Queue: File or JDBC)]
    end

    subgraph PolymarketBridge
        PolymarketToolRouter[PolymarketToolRouter]
        PolymarketApiClient[PolymarketApiClient]
        PolymarketGamma[(Polymarket Gamma API)]
        PolymarketCLOB[(Polymarket CLOB API)]
        PolymarketData[(Polymarket Data API)]
    end

    subgraph Research
        ResearchService[ContinuousImprovementResearchService]
        ResearchScheduler[ContinuousImprovementResearchScheduler]
        ResearchRouter[ContinuousResearchToolRouter]
        ResearchStore[(state/bertbot-research-recommendations.json)]
    end

    subgraph MacrofactorBridge
        MacrofactorToolRouter[MacrofactorToolRouter]
        MacrofactorMcp[(MacroFactor MCP Server)]
    end

    subgraph GoogleWorkspaceBridge
        GoogleWorkspaceToolRouter[GoogleWorkspaceToolRouter]
        GoogleWorkspaceMcp[(Google Workspace MCP Server)]
    end

    subgraph PlaywrightStoreBridge
        StoreAdapterResolver[resolveStoreAdapter\\ndisabled by default]
        HybridStoreAdapter[HybridStoreAdapter\\nAPI -> browser fallback]
        BrowserActionPolicy[AllowedBrowserActionPolicy\\nexplicit action allowlist]
        NoopBrowserAdapter[NoopBrowserStoreAdapter\\nsafe noop when Playwright absent]
    end

    subgraph ShoppingBridge
        ShoppingToolRouter[ShoppingToolRouter\\nservice-backed shopping operations]
        ShoppingGuardrails[Guardrails:\n- confirmation_token required for cart/checkout\n- budget limit check\n- seller trust score filter\n- hard-block place_order]
        StoreProviderRegistry[StoreProviderRegistry\\npriority-based provider selection]
        AmazonStoreProvider[AmazonStoreProvider\\nseeded catalog + provider mapping]
        PersonalShopperService[PersonalShopperService\\nprovider-agnostic orchestration\nand safety invariants]
    end

    subgraph BuildQuality
        JaCoCo[JaCoCo Coverage Report\\nbuild/reports/jacoco]
        SonarQube[SonarQube Community\\nlocal: docker-compose.sonarqube.yml]
        DetektReport[Detekt XML Report\\nbuild/reports/detekt]
    end

    subgraph ShoppingWorkflow
        ShoppingOnboarding[onboarding\\nset preferences & profile]
        ShoppingRecommend[recommendation\\nsuggest products]
        ShoppingCompare[compare\\nstructured product comparison]
        ShoppingCartPrepare[cart_prepare\\npropose cart, require confirm]
        ShoppingCheckoutPrepare[checkout_prepare\\nsummarise order, require confirm]
        PlaywrightFallback[Playwright fallback\\noptional browser automation]
    end

    subgraph ConfigurableStores
        StoreSelector[BERTBOT_STATE_STORE\\nfile or jdbc/postgres]
        FileStore[(File-backed JSON\nstate/ directory)]
        JdbcStore[(JDBC / PostgreSQL\ncloud store)]
        CapabilitySnapshot[RuntimeCapabilitySnapshot\\npersistenceBackend and playwrightFallbackAvailable]
    end

